  "speech_s": 6.48,
  "letters": 68,
  "lps": 10.49,
  "text": "\u0930\u0947\u0917\u093f\u0938\u094d\u0924\u093e\u0928 \u0915\u093e \u090f\u0915 \u0905\u0921\u094d\u0921\u093e, \u091c\u093f\u0938\u0915\u093e \u0928\u093e\u092e \u0924\u0915, \u0938\u0930\u0915\u093e\u0930 \u0905\u091f\u094d\u0920\u093e\u0935\u0928 \u0938\u093e\u0932 \u0928\u0939\u0940\u0902 \u0932\u0947\u0924\u0940 \u0925\u0940\u0964 \u0935\u0939\u093e\u0901 \u091b\u0941\u092a\u093e \u0915\u094d\u092f\u093e \u0939\u0948?",
  "flag": false
 },
 {
  "id": 2,
  "take": "REEL",
  "start": 8.271,
  "end": 15.476,
  "speech_s": 5.45,
  "letters": 64,
  "lps": 11.75,
  "text": "\u092f\u0947 \u0939\u0948 \u090f\u0930\u093f\u092f\u093e 51, \u0928\u0947\u0935\u093e\u0921\u093e\u0964 \u0917\u0947\u091f \u0915\u0947 \u092c\u094b\u0930\u094d\u0921 \u092a\u0930 \u0932\u093f\u0916\u093e \u0939\u0948, \u0917\u094b\u0932\u0940 \u091a\u0932\u093e\u0928\u0947 \u0915\u0940 \u0907\u091c\u093e\u091c\u093c\u0924 \u0939\u0948\u0964",
  "flag": false
 },
 {
  "id": 3,
  "take": "REEL",
  "start": 15.476,
  "end": 21.732,
  "speech_s": 4.81,
  "letters": 51,
  "lps": 10.59,
  "text": "\u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u094c \u092a\u091a\u092a\u0928\u0964 \u0938\u0940\u0906\u0908\u090f \u0928\u0947, \u092f\u0939\u093e\u0901 \u090f\u0915 \u0938\u0942\u0916\u0940 \u091d\u0940\u0932 \u092a\u0930, \u0917\u0941\u092a\u094d\u0924 \u0905\u0921\u094d\u0921\u093e \u092c\u0928\u093e\u092f\u093e\u0964",
  "flag": false
 },
 {
  "id": 4,
  "take": "REEL",
  "start": 21.732,
  "end": 26.979,
  "speech_s": 4.18,
  "letters": 41,
  "lps": 9.8,
  "text": "\u092f\u0939\u093e\u0901 \u0938\u0947 \u0909\u0921\u093c\u093e \u091c\u093e\u0938\u0942\u0938\u0940 \u0935\u093f\u092e\u093e\u0928, \u092f\u0942-\u091f\u0942, \u0938\u093e\u0920 \u0939\u091c\u093c\u093e\u0930 \u092b\u093c\u0940\u091f \u090a\u092a\u0930\u0964",
  "flag": false
 },
 {
  "id": 5,
  "take": "REEL",
  "start": 26.979,
  "end": 31.782,
  "speech_s": 3.91,
  "letters": 42,
  "lps": 10.73,
  "text": "\u0928\u0940\u091a\u0947 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947, \u0906\u0938\u092e\u093e\u0928 \u092e\u0947\u0902 \u091a\u092e\u0915\u0924\u0940 \u091a\u0940\u091c\u093c \u0926\u0947\u0916\u0940, \u0909\u0921\u093c\u0928 \u0924\u0936\u094d\u0924\u0930\u0940!",
  "flag": false
 },
 {
  "id": 6,
  "take": "REEL",
  "start": 31.782,
  "end": 37.679,
  "speech_s": 5.17,
  "letters": 66,
  "lps": 12.77,
  "text": "\u0938\u0940\u0906\u0908\u090f \u0915\u0947 \u090f\u0915 \u0905\u0927\u094d\u092f\u092f\u0928 \u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915\u093c, \u0906\u0927\u0940 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092f\u0942\u090f\u092b\u093c\u0913 \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u0947\u0902, \u092f\u0939\u0940 \u0909\u0921\u093c\u093e\u0928\u0947\u0902 \u0925\u0940\u0902\u0964",
  "flag": false
 },
 {
  "id": 7,
  "take": "REEL",
  "start": 37.679,
  "end": 46.088,
  "speech_s": 6.74,
  "letters": 82,
  "lps": 12.16,
  "text": "\u092b\u093f\u0930, \u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u094c \u0928\u0935\u093e\u0938\u0940\u0964 \u092c\u0949\u092c \u0932\u091c\u093c\u093e\u0930 \u0928\u0947 \u0926\u093e\u0935\u093e \u0915\u093f\u092f\u093e, \u092f\u0939\u093e\u0901 \u090f\u0932\u093f\u092f\u0928 \u092f\u093e\u0928 \u0939\u0948\u0902\u0964 \u092a\u0930 \u0909\u0938\u0915\u0940 \u092a\u0922\u093c\u093e\u0908 \u0915\u093e, \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0924\u0915 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964",
  "flag": false
 },
 {
  "id": 8,
  "take": "REEL",
  "start": 46.088,
  "end": 54.626,
  "speech_s": 6.96,
  "letters": 81,
  "lps": 11.64,
  "text": "\u0914\u0930 \u0905\u0938\u0932\u0940 \u0905\u0901\u0927\u0947\u0930\u093e? \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u093e \u0906\u0930\u094b\u092a, \u092f\u0939\u093e\u0901 \u091c\u093c\u0939\u0930\u0940\u0932\u093e \u0915\u091a\u0930\u093e \u091c\u0932\u093e\u092f\u093e \u0917\u092f\u093e, \u092a\u0930 \u0915\u0947\u0938, \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0939\u0915\u0930 \u092c\u0902\u0926\u0964",
  "flag": false
 },
 {
  "id": 9,
  "take": "REEL",
  "start": 54.626,
  "end": 62.082,
  "speech_s": 5.26,
  "letters": 64,
  "lps": 12.16,
  "text": "\u0926\u094b \u0939\u091c\u093c\u093e\u0930 \u0924\u0947\u0930\u0939 \u092e\u0947\u0902, \u0938\u0940\u0906\u0908\u090f \u0928\u0947 \u092e\u093e\u0928\u093e, \u0939\u093e\u0901, \u090f\u0930\u093f\u092f\u093e 51 \u0939\u0948\u0964 \u092a\u0930 \u090f\u0932\u093f\u092f\u0928? \u090f\u0915 \u0936\u092c\u094d\u0926 \u0928\u0939\u0940\u0902\u0964",
  "flag": false
 },
 {
  "id": 10,
