  "start": 23.512,
  "end": 29.22,
  "speech_s": 4.68,
  "letters": 56,
  "lps": 11.97,
  "text": "\u0914\u0930 \u0917\u0947\u091f \u092a\u0930 \u0932\u0917\u0947 \u092c\u094b\u0930\u094d\u0921 \u092a\u0930 \u0932\u093f\u0916\u093e \u0925\u093e, \u091c\u093e\u0928\u0932\u0947\u0935\u093e \u0924\u093e\u0915\u093c\u0924 \u0915\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0940, \u0907\u091c\u093e\u091c\u093c\u0924 \u0939\u0948\u0964",
  "flag": false
 },
 {
  "id": 12,
