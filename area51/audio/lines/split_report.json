  "start": 11.356,
  "end": 16.923,
  "speech_s": 4.58,
  "letters": 48,
  "lps": 10.49,
  "text": "\u0926\u0947\u0916\u0924\u0947 \u0939\u0940 \u0926\u0947\u0916\u0924\u0947, \u092c\u0940\u0938 \u0932\u093e\u0916 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0932\u093f\u0916\u093e, \u0939\u092e \u0906 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964",
