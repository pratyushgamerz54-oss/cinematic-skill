  "start": 36.854,
  "end": 42.387,
  "speech_s": 4.41,
  "letters": 47,
  "lps": 10.65,
  "text": "\u0907\u0938\u0915\u093e \u091c\u0935\u093e\u092c \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0939\u092e\u0947\u0902 \u091a\u0932\u0928\u093e \u0939\u094b\u0917\u093e, \u0932\u0917\u092d\u0917 \u0938\u0924\u094d\u0924\u0930 \u0938\u093e\u0932 \u092a\u0940\u091b\u0947\u0964",
  "flag": false
 },
 {
