  "start": 5.196,
  "end": 11.356,
  "speech_s": 4.78,
  "letters": 54,
  "lps": 11.3,
  "text": "\u092b\u093c\u0947\u0938\u092c\u0941\u0915 \u092a\u0930, \u092e\u091c\u093c\u093e\u0915\u093c \u092e\u0947\u0902, \u090f\u0915 \u0907\u0935\u0947\u0902\u091f \u092c\u0928\u093e, \u090f\u0930\u093f\u092f\u093e 51 \u092a\u0930 \u0927\u093e\u0935\u093e \u092c\u094b\u0932\u094b\u0964",
