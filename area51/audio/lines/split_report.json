  "start": 16.923,
  "end": 23.512,
  "speech_s": 5.5,
  "letters": 61,
  "lps": 11.09,
  "text": "\u092c\u0940\u0938 \u0938\u093f\u0924\u0902\u092c\u0930 \u0915\u094b, \u0917\u0947\u091f \u0924\u0915 \u092c\u0938 \u0915\u0941\u091b \u0926\u0930\u094d\u091c\u0928 \u0932\u094b\u0917 \u092a\u0939\u0941\u0901\u091a\u0947, \u0914\u0930 \u0906\u0938\u092a\u093e\u0938 \u0915\u0947 \u092e\u0947\u0932\u094b\u0902 \u092e\u0947\u0902, \u0915\u0941\u091b \u0939\u091c\u093c\u093e\u0930\u0964",
