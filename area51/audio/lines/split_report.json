  "end": 27.506,
  "speech_s": 4.64,
  "letters": 54,
  "lps": 11.63,
  "text": "\u0914\u0930 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u0938\u0935\u093e\u0932, \u0915\u094d\u092f\u093e \u0935\u0939\u093e\u0901 \u0938\u091a \u092e\u0947\u0902, \u0915\u093f\u0938\u0940 \u0926\u0942\u0938\u0930\u0940 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u093e \u0930\u093e\u091c\u093c \u091b\u0941\u092a\u093e \u0939\u0948?",
  "flag": false
 },
 {
