  "end": 30.859,
  "speech_s": 5.9,
  "letters": 58,
  "lps": 9.84,
  "text": "\u092a\u0930 \u091c\u093e\u0901\u091a \u091f\u0940\u092e\u094b\u0902 \u0928\u0947, \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092c\u0924\u093e\u092f\u093e, \u0936\u093e\u092f\u0926 \u092e\u094c\u0938\u092e, \u0936\u093e\u092f\u0926 \u0924\u093e\u0930\u0947\u0964 \u0905\u0938\u0932\u0940 \u0935\u091c\u0939, \u091b\u0941\u092a\u093e \u0932\u0940 \u0917\u0908\u0964",
