  "take": "T02_origin",
  "start": 0.0,
  "end": 9.567,
  "speech_s": 7.7,
  "letters": 79,
  "lps": 10.26,
  "text": "\u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u094c \u092a\u091a\u092a\u0928\u0964 \u0936\u0940\u0924 \u092f\u0941\u0926\u094d\u0927 \u091a\u0930\u092e \u092a\u0930 \u0925\u093e, \u0914\u0930 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0925\u093e, \u0938\u094b\u0935\u093f\u092f\u0924 \u0938\u0902\u0918 \u0915\u0947 \u092a\u0930\u092e\u093e\u0923\u0941 \u092c\u092e, \u0915\u0939\u093e\u0901 \u091b\u0941\u092a\u0947 \u0939\u0948\u0902?",
  "flag": false
 },
 {
  "id": 15,
  "take": "T02_origin",
  "start": 9.567,
  "end": 19.353,
  "speech_s": 7.25,
  "letters": 77,
  "lps": 10.63,
  "text": "\u0938\u0940\u0906\u0908\u090f \u0928\u0947 \u092c\u0928\u0935\u093e\u092f\u093e, \u090f\u0915 \u0910\u0938\u093e \u091c\u093e\u0938\u0942\u0938\u0940 \u0935\u093f\u092e\u093e\u0928, \u091c\u093f\u0938\u0947 \u0915\u094b\u0908 \u091b\u0942 \u0928 \u0938\u0915\u0947, \u092f\u0942-\u091f\u0942\u0964 \u0932\u0949\u0915\u0939\u0940\u0921 \u0915\u0940 \u0917\u0941\u092a\u094d\u0924 \u091f\u0940\u092e, \u0938\u094d\u0915\u0902\u0915 \u0935\u0930\u094d\u0915\u094d\u0938 \u0928\u0947\u0964",
  "flag": false
 },
 {
  "id": 16,
  "take": "T02_origin",
  "start": 19.353,
  "end": 29.823,
  "speech_s": 7.93,
  "letters": 82,
  "lps": 10.35,
  "text": "\u0905\u092a\u094d\u0930\u0948\u0932, \u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u094c \u092a\u091a\u092a\u0928\u0964 \u0938\u0940\u0906\u0908\u090f \u0915\u0940 \u091f\u0940\u092e \u0915\u094b, \u0928\u0947\u0935\u093e\u0921\u093e \u0915\u0947 \u0930\u0947\u0917\u093f\u0938\u094d\u0924\u093e\u0928 \u092e\u0947\u0902 \u0926\u093f\u0916\u0940, \u090f\u0915 \u0938\u0942\u0916\u0940, \u0938\u092b\u093c\u0947\u0926, \u0938\u092e\u0924\u0932 \u091d\u0940\u0932, \u0917\u094d\u0930\u0942\u092e \u0932\u0947\u0915\u0964",
  "flag": false
 },
 {
  "id": 17,
  "take": "T02_origin",
  "start": 29.823,
  "end": 36.264,
  "speech_s": 5.36,
  "letters": 58,
  "lps": 10.82,
  "text": "\u0920\u0940\u0915 \u092c\u0917\u0932 \u092e\u0947\u0902 \u0925\u093e, \u092a\u0930\u092e\u093e\u0923\u0941 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u093e \u0907\u0932\u093e\u0915\u093c\u093e\u0964 \u092f\u093e\u0928\u0940, \u0915\u094b\u0908 \u092d\u0942\u0932\u0915\u0930 \u092d\u0940, \u0907\u0927\u0930 \u0928\u0939\u0940\u0902 \u0906\u0924\u093e\u0964",
  "flag": false
 },
 {
