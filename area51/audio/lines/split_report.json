  "start": 15.02,
  "end": 23.116,
  "speech_s": 6.39,
  "letters": 64,
  "lps": 10.02,
  "text": "\u0928\u0940\u091a\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u0926\u093f\u0916\u0924\u0940, \u0906\u0938\u092e\u093e\u0928 \u092e\u0947\u0902 \u090f\u0915 \u091a\u092e\u0915\u0924\u0940, \u0905\u0928\u091c\u093e\u0928 \u091a\u0940\u091c\u093c, \u0914\u0930 \u092b\u093c\u094b\u0928 \u092c\u091c\u0928\u0947 \u0932\u0917\u0924\u0947: \u0909\u0921\u093c\u0928 \u0924\u0936\u094d\u0924\u0930\u0940!",
