  "start": 29.22,
  "end": 36.854,
  "speech_s": 6.31,
  "letters": 64,
  "lps": 10.15,
  "text": "\u0924\u094b \u0938\u0935\u093e\u0932 \u092f\u0947 \u0939\u0948, \u0907\u0938 \u092c\u0902\u0926 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0947 \u092a\u0940\u091b\u0947, \u0906\u0916\u093c\u093f\u0930 \u0910\u0938\u093e \u0915\u094d\u092f\u093e \u0939\u0948, \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u0917\u094b\u0932\u0940 \u0924\u0915 \u091a\u0932 \u0938\u0915\u0924\u0940 \u0939\u0948?",
