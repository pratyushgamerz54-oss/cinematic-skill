  "end": 35.851,
  "speech_s": 6.56,
  "letters": 70,
  "lps": 10.67,
  "text": "\u0906\u091c \u0939\u092e \u0916\u094b\u0932\u0947\u0902\u0917\u0947, \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u0930\u0939\u0938\u094d\u092f\u092e\u092f\u0940 \u0905\u0921\u094d\u0921\u0947 \u0915\u093e, \u092a\u0942\u0930\u093e \u0915\u091a\u094d\u091a\u093e \u091a\u093f\u091f\u094d\u0920\u093e\u0964 \u090f\u0930\u093f\u092f\u093e 51\u0964",
