  "start": 6.679,
  "end": 15.02,
  "speech_s": 6.36,
  "letters": 70,
  "lps": 11.01,
  "text": "\u0909\u0938 \u091c\u093c\u092e\u093e\u0928\u0947 \u092e\u0947\u0902, \u092f\u093e\u0924\u094d\u0930\u0940 \u0935\u093f\u092e\u093e\u0928, \u092c\u0940\u0938 \u0939\u091c\u093c\u093e\u0930 \u092b\u093c\u0940\u091f \u0924\u0915 \u0909\u0921\u093c\u0924\u0947 \u0925\u0947\u0964 \u0914\u0930 \u092f\u0942-\u091f\u0942? \u0938\u093e\u0920 \u0939\u091c\u093c\u093e\u0930 \u092b\u093c\u0940\u091f \u0938\u0947 \u092d\u0940 \u090a\u092a\u0930\u0964",
  "flag": false
 },
 {
