  "speech_s": 7.75,
  "letters": 87,
  "lps": 11.23,
  "text": "\u0935\u0939\u093e\u0901 \u0915\u0947 \u0906\u0938\u092e\u093e\u0928 \u092e\u0947\u0902, \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u0905\u091c\u0940\u092c \u0930\u094b\u0936\u0928\u093f\u092f\u093e\u0901 \u0915\u094d\u092f\u094b\u0902 \u0926\u093f\u0916\u0924\u0940 \u0925\u0940\u0902? \u0914\u0930 \u0935\u0939\u093e\u0901 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u094b\u0902 \u092a\u0930, \u0917\u094b\u0932\u0940 \u091a\u0932\u093e\u0928\u0947 \u0915\u0940 \u0907\u091c\u093e\u091c\u093c\u0924 \u0915\u094d\u092f\u094b\u0902 \u0939\u0948?",
  "flag": false
 },
 {
