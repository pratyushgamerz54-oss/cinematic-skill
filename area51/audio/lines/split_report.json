  "start": 0.0,
  "end": 6.679,
  "speech_s": 4.94,
  "letters": 50,
  "lps": 10.12,
  "text": "\u0905\u0917\u0938\u094d\u0924, \u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u094c \u092a\u091a\u092a\u0928\u0964 \u092f\u0942-\u091f\u0942 \u0928\u0947, \u092a\u0939\u0932\u0940 \u092c\u093e\u0930, \u0917\u094d\u0930\u0942\u092e \u0932\u0947\u0915 \u0938\u0947 \u0909\u0921\u093c\u093e\u0928 \u092d\u0930\u0940\u0964",
