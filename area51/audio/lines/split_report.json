  "take": "T02_origin",
  "start": 36.264,
  "end": 43.453,
  "speech_s": 5.36,
  "letters": 64,
  "lps": 11.95,
  "text": "\u0928\u0915\u093c\u094d\u0936\u0947 \u092a\u0930, \u0907\u0938 \u091c\u093c\u092e\u0940\u0928 \u0915\u093e \u0928\u0902\u092c\u0930 \u0925\u093e, \u0907\u0915\u094d\u092f\u093e\u0935\u0928\u0964 \u0914\u0930 \u092f\u0939\u0940\u0902 \u0938\u0947 \u091c\u0928\u094d\u092e \u0939\u0941\u0906, \u090f\u0930\u093f\u092f\u093e 51 \u0915\u093e\u0964",
  "flag": false
 },
 {
