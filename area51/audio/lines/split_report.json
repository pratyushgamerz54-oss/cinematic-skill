  "start": 43.453,
  "end": 50.937,
  "speech_s": 6.14,
  "letters": 67,
  "lps": 10.91,
  "text": "\u0932\u0947\u0915\u093f\u0928 \u0907\u0938 \u0938\u0942\u0916\u0940 \u091d\u0940\u0932 \u0938\u0947, \u091c\u0932\u094d\u0926 \u0939\u0940, \u0915\u0941\u091b \u0910\u0938\u093e \u0909\u0921\u093c\u0928\u0947 \u0935\u093e\u0932\u093e \u0925\u093e, \u091c\u093f\u0938\u0928\u0947 \u092a\u0942\u0930\u0947 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u094b \u091a\u094c\u0902\u0915\u093e \u0926\u093f\u092f\u093e\u0964",
