  "end": 5.196,
  "speech_s": 4.33,
  "letters": 45,
  "lps": 10.38,
  "text": "\u0938\u093f\u0924\u0902\u092c\u0930, \u0926\u094b \u0939\u091c\u093c\u093e\u0930 \u0909\u0928\u094d\u0928\u0940\u0938\u0964 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u093e \u0928\u0947\u0935\u093e\u0921\u093e \u0930\u0947\u0917\u093f\u0938\u094d\u0924\u093e\u0928\u0964",
