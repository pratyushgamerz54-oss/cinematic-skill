  "start": 89.872,
  "end": 95.974,
  "speech_s": 5.13,
  "letters": 58,
  "lps": 11.31,
  "text": "\u092b\u093f\u0930 \u092a\u0941\u0930\u093e\u0928\u0947 \u0926\u0947\u0935\u0924\u093e \u0932\u094c\u091f\u093e\u090f \u0917\u090f, \u092e\u0902\u0926\u093f\u0930 \u092b\u093f\u0930 \u0916\u0941\u0932\u0947, \u0914\u0930 \u0930\u093e\u091c\u093e \u0915\u093e \u0928\u093e\u092e \u092c\u0928\u093e: \u0924\u0942\u0924\u0928\u0916\u093c\u093e\u092e\u0941\u0928\u0964",
