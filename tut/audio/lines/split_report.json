  "speech_s": 4.25,
  "letters": 47,
  "lps": 11.06,
  "text": "\u0932\u0917\u092d\u0917 \u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u093e\u0932 \u0915\u0940 \u0909\u092e\u094d\u0930 \u092e\u0947\u0902, \u0924\u0942\u0924\u0928\u0916\u093c\u093e\u092e\u0941\u0928 \u0915\u0940 \u0905\u091a\u093e\u0928\u0915 \u092e\u094c\u0924 \u0939\u094b \u0917\u0908\u0964",
