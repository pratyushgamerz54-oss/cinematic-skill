  "start": 71.615,
  "end": 78.368,
  "speech_s": 5.53,
  "letters": 55,
  "lps": 9.95,
  "text": "\u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u092c\u091a\u094d\u091a\u093e, \u092c\u0939\u0941\u0924 \u091c\u0932\u094d\u0926, \u090f\u0915 \u0910\u0938\u0947 \u0924\u0916\u093c\u094d\u0924 \u092a\u0930 \u092c\u0948\u0920\u0928\u0947 \u0935\u093e\u0932\u093e \u0925\u093e, \u091c\u094b \u0906\u0917 \u092a\u0930 \u0930\u0916\u093e \u0925\u093e\u0964",
  "flag": false
 },
 {
  "id": 17,
  "take": "STORY",
  "start": 78.368,
  "end": 83.349,
  "speech_s": 4.18,
  "letters": 45,
  "lps": 10.78,
  "text": "\u0915\u0941\u091b \u0939\u0940 \u0938\u093e\u0932 \u092c\u093e\u0926, \u0932\u0917\u092d\u0917 \u0928\u094c \u0938\u093e\u0932 \u0915\u0940 \u0909\u092e\u094d\u0930 \u092e\u0947\u0902, \u092f\u0947 \u092c\u091a\u094d\u091a\u093e \u092b\u093c\u0930\u093e\u0913 \u092c\u0928\u093e\u0964",
