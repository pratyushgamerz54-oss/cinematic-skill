  "start": 95.974,
  "end": 100.798,
  "speech_s": 4.32,
  "letters": 45,
  "lps": 10.41,
  "text": "\u0909\u0938\u0915\u0940 \u0930\u093e\u0928\u0940 \u0925\u0940 \u0905\u0902\u0916\u0947\u0938\u0947\u0928\u093e\u092e\u0941\u0928, \u091c\u094b \u0936\u093e\u092f\u0926 \u0909\u0938\u0915\u0940 \u0938\u094c\u0924\u0947\u0932\u0940 \u092c\u0939\u0928 \u092d\u0940 \u0925\u0940\u0964",
