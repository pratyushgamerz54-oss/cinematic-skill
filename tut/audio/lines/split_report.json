  "start": 11.136,
  "end": 17.172,
  "speech_s": 4.62,
  "letters": 44,
  "lps": 9.53,
  "text": "\u092b\u093f\u0930 \u092d\u0940, \u0906\u091c \u0935\u094b \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u093e \u0938\u092c\u0938\u0947 \u092e\u0936\u0939\u0942\u0930 \u092b\u093c\u0930\u093e\u0913 \u0939\u0948\u0964 \u0924\u0942\u0924\u0928\u0916\u093c\u093e\u092e\u0941\u0928\u0964",
  "flag": false
 },
 {
