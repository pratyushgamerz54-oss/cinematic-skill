  "start": 67.375,
  "end": 71.615,
  "speech_s": 3.58,
  "letters": 38,
  "lps": 10.62,
  "text": "\u0907\u0938\u0940 \u0909\u0925\u0932-\u092a\u0941\u0925\u0932 \u092e\u0947\u0902 \u092a\u0948\u0926\u093e \u0939\u0941\u0906 \u090f\u0915 \u092c\u091a\u094d\u091a\u093e, \u0924\u0942\u0924\u0928\u0916\u093c\u093e\u0924\u0947\u0928\u0964",
  "flag": false
 },
 {
