  "speech_s": 1.29,
  "letters": 18,
  "lps": 13.91,
  "text": "\u0924\u094b \u091a\u0932\u093f\u090f, \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
  "flag": false
 },
 {
  "id": 5,
  "take": "STORY",
  "start": 0.0,
  "end": 5.825,
  "speech_s": 4.22,
  "letters": 42,
  "lps": 9.96,
  "text": "\u091b\u092c\u094d\u092c\u0940\u0938 \u0928\u0935\u0902\u092c\u0930, \u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u094c \u092c\u093e\u0908\u0938\u0964 \u092e\u093f\u0938\u094d\u0930, \u0930\u093e\u091c\u093e\u0913\u0902 \u0915\u0940 \u0918\u093e\u091f\u0940\u0964",
  "flag": false
 },
 {
  "id": 6,
  "take": "STORY",
  "start": 5.825,
  "end": 12.092,
  "speech_s": 5.28,
  "letters": 59,
  "lps": 11.18,
  "text": "\u090f\u0915 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u093c \u092a\u0941\u0930\u093e\u0924\u0924\u094d\u0935\u0935\u093f\u0926\u094d, \u0939\u093e\u0935\u0930\u094d\u0921 \u0915\u093e\u0930\u094d\u091f\u0930, \u090f\u0915 \u092c\u0902\u0926 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u092e\u0947\u0902 \u091b\u0947\u0926 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
  "flag": false
 },
 {
  "id": 7,
  "take": "STORY",
  "start": 12.092,
  "end": 18.126,
  "speech_s": 4.49,
  "letters": 43,
  "lps": 9.57,
  "text": "\u0939\u093e\u0925 \u092e\u0947\u0902 \u092e\u094b\u092e\u092c\u0924\u094d\u0924\u0940, \u0914\u0930 \u0938\u093e\u092e\u0928\u0947, \u0939\u091c\u093c\u093e\u0930\u094b\u0902 \u0938\u093e\u0932 \u0938\u0947 \u092c\u0902\u0926 \u0905\u0901\u0927\u0947\u0930\u093e\u0964",
  "flag": false
 },
 {
  "id": 8,
  "take": "STORY",
  "start": 18.126,
  "end": 26.306,
  "speech_s": 5.39,
  "letters": 58,
  "lps": 10.77,
  "text": "\u092a\u0940\u091b\u0947 \u0938\u0947 \u0906\u0935\u093e\u091c\u093c \u0906\u0908: \u0915\u0941\u091b \u0926\u093f\u0916 \u0930\u0939\u093e \u0939\u0948? \u0915\u093e\u0930\u094d\u091f\u0930 \u092c\u0938 \u0907\u0924\u0928\u093e \u0915\u0939 \u092a\u093e\u092f\u093e: \u0939\u093e\u0901, \u0905\u0926\u094d\u092d\u0941\u0924 \u091a\u0940\u091c\u093c\u0947\u0902\u0964",
  "flag": false
 },
 {
  "id": 9,
  "take": "STORY",
  "start": 26.306,
  "end": 31.692,
  "speech_s": 4.25,
  "letters": 43,
  "lps": 10.12,
  "text": "\u0905\u0902\u0926\u0930 \u0925\u093e, \u090f\u0915 \u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u093e\u0932 \u0915\u0947 \u0930\u093e\u091c\u093e \u0915\u093e \u0916\u093c\u091c\u093c\u093e\u0928\u093e\u0964 \u0924\u0942\u0924\u0928\u0916\u093c\u093e\u092e\u0941\u0928\u0964",
  "flag": false
 },
 {
  "id": 10,
  "take": "STORY",
  "start": 31.692,
  "end": 42.196,
  "speech_s": 7.69,
  "letters": 74,
  "lps": 9.62,
  "text": "\u092a\u0930 \u0938\u0935\u093e\u0932 \u092f\u0947 \u0939\u0948: \u0907\u0924\u0928\u093e \u0924\u093e\u0915\u093c\u0924\u0935\u0930 \u0930\u093e\u091c\u093e, \u0907\u0924\u0928\u0940 \u0915\u092e \u0909\u092e\u094d\u0930 \u092e\u0947\u0902 \u0915\u094d\u092f\u094b\u0902 \u092e\u0930\u093e? \u0914\u0930 \u0909\u0938\u0915\u093e \u0928\u093e\u092e, \u0907\u0924\u093f\u0939\u093e\u0938 \u0938\u0947 \u0915\u093f\u0938\u0928\u0947 \u092e\u093f\u091f\u093e\u092f\u093e?",
  "flag": false
 },
 {
  "id": 11,
  "take": "STORY",
  "start": 42.196,
  "end": 48.098,
  "speech_s": 4.91,
  "letters": 54,
  "lps": 10.99,
  "text": "\u0906\u091c, \u0938\u092c\u0942\u0924\u094b\u0902 \u0915\u0947 \u0938\u0939\u093e\u0930\u0947, \u0939\u092e \u0907\u0938 \u0924\u0940\u0928 \u0939\u091c\u093c\u093e\u0930 \u0938\u093e\u0932 \u092a\u0941\u0930\u093e\u0928\u0947 \u0930\u0939\u0938\u094d\u092f \u0915\u0940 \u0924\u0939 \u0924\u0915 \u091c\u093e\u090f\u0901\u0917\u0947\u0964",
  "flag": false
 },
 {
  "id": 12,
  "take": "STORY",
  "start": 48.098,
  "end": 54.993,
  "speech_s": 5.73,
  "letters": 64,
  "lps": 11.16,
  "text": "\u0915\u0939\u093e\u0928\u0940 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u0940 \u0939\u0948, \u0932\u0917\u092d\u0917 \u0924\u0940\u0928 \u0939\u091c\u093c\u093e\u0930 \u0924\u0940\u0928 \u0938\u094c \u0938\u093e\u0932 \u092a\u0939\u0932\u0947, \u092b\u093c\u0930\u093e\u0913 \u0905\u0916\u093c\u0947\u0928\u093e\u0924\u0947\u0928 \u0915\u0947 \u092e\u093f\u0938\u094d\u0930 \u092e\u0947\u0902\u0964",
  "flag": false
 },
 {
  "id": 13,
