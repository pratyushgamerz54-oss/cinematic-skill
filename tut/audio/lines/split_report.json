  "start": 83.349,
  "end": 89.872,
  "speech_s": 5.7,
  "letters": 55,
  "lps": 9.65,
  "text": "\u0909\u0938\u0915\u0947 \u091a\u093e\u0930\u094b\u0902 \u0913\u0930 \u0925\u0947 \u0926\u094b \u0924\u093e\u0915\u093c\u0924\u0935\u0930 \u0932\u094b\u0917: \u092c\u0942\u0922\u093c\u093e \u0935\u091c\u093c\u0940\u0930 \u0906\u092f, \u0914\u0930 \u0938\u0947\u0928\u093e\u092a\u0924\u093f \u0939\u094b\u0930\u0947\u092e\u0939\u0947\u092c\u0964",
