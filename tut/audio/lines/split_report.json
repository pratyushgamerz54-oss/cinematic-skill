  "speech_s": 6.34,
  "letters": 66,
  "lps": 10.41,
  "text": "\u0906\u091c \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0948, \u090f\u0915 \u0910\u0938\u0947 \u0930\u093e\u091c\u093e \u0915\u0940, \u091c\u094b \u0909\u0928\u094d\u0928\u0940\u0938 \u0915\u0940 \u0909\u092e\u094d\u0930 \u092e\u0947\u0902 \u092e\u0930 \u0917\u092f\u093e, \u0914\u0930 \u091c\u093f\u0938\u0915\u093e \u0928\u093e\u092e \u092e\u093f\u091f\u093e \u0926\u093f\u092f\u093e \u0917\u092f\u093e\u0964",
  "flag": false
 },
 {
