  "start": 54.993,
  "end": 62.265,
  "speech_s": 5.95,
  "letters": 69,
  "lps": 11.6,
  "text": "\u0909\u0938\u0928\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0915\u094b \u091b\u094b\u0921\u093c, \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0926\u0947\u0935\u0924\u093e \u0915\u0940 \u092a\u0942\u091c\u093e \u0915\u093e \u0939\u0941\u0915\u094d\u092e \u0926\u093f\u092f\u093e: \u0938\u0942\u0930\u094d\u092f \u0915\u093e \u0917\u094b\u0932\u093e, \u0906\u0924\u0947\u0928\u0964",
  "flag": false
 },
 {
  "id": 14,
  "take": "STORY",
  "start": 62.265,
  "end": 67.375,
  "speech_s": 4.14,
  "letters": 45,
  "lps": 10.86,
  "text": "\u092e\u0902\u0926\u093f\u0930 \u092c\u0902\u0926 \u0939\u0941\u090f, \u0914\u0930 \u0930\u0947\u0917\u093f\u0938\u094d\u0924\u093e\u0928 \u092e\u0947\u0902 \u092c\u0938\u0940 \u090f\u0915 \u0928\u0908 \u0930\u093e\u091c\u0927\u093e\u0928\u0940: \u0905\u092e\u0930\u0928\u093e\u0964",
  "flag": false
 },
 {
