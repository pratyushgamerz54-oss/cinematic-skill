[
 {
  "id": 1,
  "take": "REEL",
  "start": 0.0,
  "end": 8.445,
  "speech_s": 7.11,
  "letters": 62,
  "lps": 8.72,
  "text": "\u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u093e\u0932 \u0915\u093e \u090f\u0915 \u0930\u093e\u091c\u093e, \u091c\u093f\u0938\u0915\u093e \u0928\u093e\u092e \u092e\u093f\u091f\u093e \u0926\u093f\u092f\u093e \u0917\u092f\u093e\u0964 \u0935\u0939\u0940 \u0906\u091c, \u0938\u092c\u0938\u0947 \u092e\u0936\u0939\u0942\u0930 \u092b\u093c\u0930\u093e\u0913 \u0915\u0948\u0938\u0947 \u0939\u0948?",
  "flag": false
 },
 {
  "id": 2,
  "take": "REEL",
  "start": 8.445,
  "end": 16.346,
  "speech_s": 6.13,
  "letters": 60,
  "lps": 9.8,
  "text": "\u092f\u0947 \u0939\u0948 \u0924\u0942\u0924\u0928\u0916\u093c\u093e\u092e\u0941\u0928\u0964 \u0928\u094c \u0938\u093e\u0932 \u0915\u0940 \u0909\u092e\u094d\u0930 \u092e\u0947\u0902 \u0930\u093e\u091c\u093e \u092c\u0928\u093e, \u0914\u0930 \u0932\u0917\u092d\u0917 \u0909\u0928\u094d\u0928\u0940\u0938 \u092e\u0947\u0902, \u0905\u091a\u093e\u0928\u0915 \u092e\u094c\u0924\u0964",
  "flag": false
 },
 {
  "id": 3,
  "take": "REEL",
  "start": 16.346,
  "end": 22.502,
  "speech_s": 5.76,
  "letters": 60,
  "lps": 10.42,
  "text": "\u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0915\u0947 \u0930\u093e\u091c\u093e\u0913\u0902 \u0928\u0947, \u0909\u0938\u0915\u093e \u0928\u093e\u092e, \u0938\u094d\u092e\u093e\u0930\u0915\u094b\u0902 \u0914\u0930 \u0930\u093e\u091c\u093e\u0913\u0902 \u0915\u0940 \u0938\u0942\u091a\u093f\u092f\u094b\u0902 \u0938\u0947 \u092e\u093f\u091f\u093e \u0926\u093f\u092f\u093e\u0964",
  "flag": false
 },
 {
  "id": 4,
  "take": "REEL",
  "start": 22.502,
  "end": 28.593,
  "speech_s": 5.32,
  "letters": 51,
  "lps": 9.58,
  "text": "\u0914\u0930 \u0909\u0938\u0915\u0940 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0915\u092c\u094d\u0930, \u092e\u0932\u092c\u0947 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0926\u092c\u0915\u0930, \u0924\u0940\u0928 \u0939\u091c\u093c\u093e\u0930 \u0938\u093e\u0932 \u0924\u0915 \u091b\u093f\u092a\u0940 \u0930\u0939\u0940\u0964",
  "flag": false
 },
 {
  "id": 5,
  "take": "REEL",
  "start": 28.593,
  "end": 37.777,
  "speech_s": 6.91,
  "letters": 75,
  "lps": 10.86,
  "text": "\u092b\u093f\u0930, \u0909\u0928\u094d\u0928\u0940\u0938 \u0938\u094c \u092c\u093e\u0908\u0938\u0964 \u0939\u093e\u0935\u0930\u094d\u0921 \u0915\u093e\u0930\u094d\u091f\u0930 \u0928\u0947 \u092e\u094b\u092e\u092c\u0924\u094d\u0924\u0940 \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u092e\u0947\u0902 \u0905\u0902\u0926\u0930 \u091d\u093e\u0901\u0915\u093e, \u0914\u0930 \u0915\u0939\u093e: \u0905\u0926\u094d\u092d\u0941\u0924 \u091a\u0940\u091c\u093c\u0947\u0902\u0964",
  "flag": false
 },
 {
  "id": 6,
  "take": "REEL",
  "start": 37.777,
  "end": 43.171,
  "speech_s": 5.16,
  "letters": 58,
  "lps": 11.24,
  "text": "\u0905\u0902\u0926\u0930 \u0925\u0940\u0902 \u092a\u093e\u0901\u091a \u0939\u091c\u093c\u093e\u0930 \u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u091a\u0940\u091c\u093c\u0947\u0902, \u0914\u0930 \u090f\u0915 \u0938\u094c \u0926\u0938 \u0915\u093f\u0932\u094b \u0920\u094b\u0938 \u0938\u094b\u0928\u0947 \u0915\u093e \u0924\u093e\u092c\u0942\u0924\u0964",
  "flag": false
 },
 {
  "id": 7,
  "take": "REEL",
  "start": 43.171,
  "end": 49.246,
  "speech_s": 5.46,
  "letters": 64,
  "lps": 11.72,
  "text": "\u092a\u0930 \u0930\u093e\u091c\u093e \u092e\u0930\u093e \u0915\u0948\u0938\u0947? \u0916\u094b\u092a\u0921\u093c\u0940 \u0915\u0947 \u090f\u0915\u094d\u0938-\u0930\u0947 \u092e\u0947\u0902 \u0926\u093f\u0916\u0947 \u0939\u0921\u094d\u0921\u0940 \u0915\u0947 \u091f\u0941\u0915\u0921\u093c\u0947 \u0928\u0947, \u0939\u0924\u094d\u092f\u093e \u0915\u093e \u0936\u0915 \u091c\u0917\u093e\u092f\u093e\u0964",
  "flag": false
 },
 {
  "id": 8,
  "take": "REEL",
  "start": 49.246,
  "end": 54.159,
  "speech_s": 4.59,
  "letters": 54,
  "lps": 11.76,
  "text": "\u092b\u093f\u0930 \u0921\u0940\u090f\u0928\u090f \u091c\u093e\u0901\u091a \u092e\u0947\u0902 \u092e\u093f\u0932\u0947, \u092e\u0932\u0947\u0930\u093f\u092f\u093e \u0915\u0947 \u0928\u093f\u0936\u093e\u0928, \u0914\u0930 \u092a\u0948\u0930 \u0915\u0940 \u0939\u0921\u094d\u0921\u0940 \u0915\u0940 \u092c\u0940\u092e\u093e\u0930\u0940\u0964",
  "flag": false
 },
 {
  "id": 9,
  "take": "REEL",
  "start": 54.159,
  "end": 59.872,
  "speech_s": 4.77,
  "letters": 58,
  "lps": 12.15,
  "text": "\u0935\u093f\u0921\u0902\u092c\u0928\u093e \u0926\u0947\u0916\u093f\u090f: \u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0909\u0938\u0947 \u092d\u0941\u0932\u093e\u092f\u093e, \u0909\u0928\u094d\u0939\u0940\u0902 \u0915\u0940 \u0935\u091c\u0939 \u0938\u0947 \u0909\u0938\u0915\u0940 \u0915\u092c\u094d\u0930 \u092c\u091a\u0940 \u0930\u0939\u0940\u0964",
  "flag": false
 },
 {
  "id": 10,
  "take": "REEL",
  "start": 59.872,
  "end": 66.678,
  "speech_s": 4.9,
  "letters": 52,
  "lps": 10.61,
  "text": "\u0924\u094b \u0924\u0942\u0924\u0928\u0916\u093c\u093e\u092e\u0941\u0928 \u0915\u0940 \u092e\u094c\u0924, \u092c\u0940\u092e\u093e\u0930\u0940 \u0925\u0940, \u0939\u093e\u0926\u0938\u093e, \u092f\u093e \u0938\u093e\u091c\u093c\u093f\u0936? \u0906\u092a \u0915\u094d\u092f\u093e \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902?",
  "flag": false
